# Copy this file to .env before running Docker Compose.
# Replace this value before starting. It only applies when creating a new database.
# For an existing database, change the password in the application settings.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

WEB_PORT=8080
TZ=Asia/Shanghai
LOG_LEVEL=INFO
SQL_LOG_ENABLED=true

AUTO_REPLY_ENABLED=true
AUTO_DELIVERY_ENABLED=true
AI_REPLY_ENABLED=false

# Optional resource limits.
MEMORY_LIMIT=2048M
MEMORY_RESERVATION=512M
CPU_LIMIT=2.0
CPU_RESERVATION=0.5
