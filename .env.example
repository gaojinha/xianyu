# Copy this file to .env before running Docker Compose.
# Replace this value before starting. It only applies when creating a new database.
# For an existing database, change the password in the application settings.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

WEB_PORT=8080
TZ=Asia/Shanghai
LOG_LEVEL=INFO
SQL_LOG_ENABLED=true

# Optional release metadata; pass the source commit when building a release image.
APP_VERSION=3.2.0
APP_REVISION=unknown
IMAGE_TAG=latest

# Persist migration snapshots and keep the encryption key with restricted permissions.
MIGRATION_BACKUP_DIR=/app/backups/migrations
APP_ENCRYPTION_KEY_FILE=/app/data/app-encryption.key

AUTO_REPLY_ENABLED=true
AUTO_DELIVERY_ENABLED=true
AI_REPLY_ENABLED=false

# Optional resource limits.
MEMORY_LIMIT=2048M
MEMORY_RESERVATION=512M
CPU_LIMIT=2.0
CPU_RESERVATION=0.5
